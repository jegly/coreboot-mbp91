if BOARD_APPLE_MACBOOKPRO9_1

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select BOARD_ROMSIZE_KB_8192
	select DRIVERS_APPLE_HYBRID_GRAPHICS
	select EC_ACPI
	select GFX_GMA_PANEL_1_ON_LVDS
	# This board's LVDS presence strap does not read as set at cold boot,
	# so libgfxinit would mark the port invalid and refuse to program it.
	select GFX_GMA_IGNORE_PRESENCE_STRAPS
	select HAVE_ACPI_RESUME
	select HAVE_ACPI_TABLES
	select HAVE_CMOS_DEFAULT
	select HAVE_OPTION_TABLE
	select INTEL_INT15
	select MAINBOARD_HAS_LIBGFXINIT
	select NORTHBRIDGE_INTEL_SANDYBRIDGE
	select NO_UART_ON_SUPERIO
	select SERIRQ_CONTINUOUS_MODE
	select SOUTHBRIDGE_INTEL_C216
	select SYSTEM_TYPE_LAPTOP
	select USE_NATIVE_RAMINIT

config MAINBOARD_DIR
	default "apple/macbookpro9_1"

config MAINBOARD_PART_NUMBER
	default "MacBookPro9,1"

config VGA_BIOS_ID
	default "8086,0166"

# The internal panel is wired for DUAL-CHANNEL LVDS even though its pixel
# clock (88.75 MHz) sits below libgfxinit's default 95 MHz threshold, so the
# default would drive it single-channel and it would not come up. Linux has
# the same problem and solves it with a DMI quirk: booting this machine logs
#   [drm] Forcing lvds to dual link mode on Apple MacBook Pro 15" (2012)
# from the intel_dual_link_lvds table in i915. Lower the threshold below the
# panel's only mode so libgfxinit always powers channel B.
config GFX_GMA_LVDS_DUAL_THRESHOLD
	default 80000000

# TODO: verify against an inteltool GPIO dump taken under the vendor firmware.
# Inherited from MacBookPro10,1 -- the two boards are not guaranteed to match.
config DRAM_RESET_GATE_GPIO
	default 28

config USBDEBUG_HCD_INDEX
	default 0

endif
