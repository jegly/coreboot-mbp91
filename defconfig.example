# Example coreboot config for the MacBookPro9,1 (mbp91-coreboot).
#
# EDIT THE TWO PATHS BELOW to point at the descriptor and ME region extracted
# from YOUR OWN flash dump:
#     flashrom -p <programmer> -r mydump.bin
#     ifdtool -x mydump.bin
#
CONFIG_VENDOR_APPLE=y
CONFIG_BOARD_APPLE_MACBOOKPRO9_1=y
CONFIG_MAINBOARD_USE_LIBGFXINIT=y

CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_IFD_BIN_PATH="/path/to/flashregion_0_flashdescriptor.bin"
CONFIG_ME_BIN_PATH="/path/to/flashregion_2_intel_me.bin"

# CRITICAL: coreboot's DEFAULT is UNLOCK_FLASH_REGIONS, which runs `ifdtool -u`
# on the finished image and undoes your descriptor's write protection --
# regardless of the descriptor you supplied above. This keeps it as-is.
CONFIG_DO_NOT_TOUCH_DESCRIPTOR_REGION=y

# No microcode in the ROM; Linux loads it from the initramfs. Remove this and
# fetch 3rdparty/intel-microcode if you would rather have it in firmware.
CONFIG_CPU_MICROCODE_CBFS_NONE=y

# GRUB payload, with the menu from grub.cfg embedded in CBFS. Without the
# menu the payload drops straight to a bare rescue prompt.
CONFIG_PAYLOAD_GRUB2=y
CONFIG_GRUB2_INCLUDE_RUNTIME_CONFIG_FILE=y
CONFIG_GRUB2_RUNTIME_CONFIG_FILE="/path/to/grub.cfg"

# Text-mode console. Switching to a linear framebuffer (needed for a
# bootsplash) requires porting the no-EDID panel-mode fallback in patch 0004
# from text_fb/gma-gfx_init.adb to hires_fb/gma-gfx_init.adb, or the panel
# will stay dark again.
CONFIG_VGA_TEXT_FRAMEBUFFER=y
